{
  "name": "polymarket-book-vis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "proto:generate": "buf generate && prettier --write src/gen",
    "proto:check": "buf lint && bun run proto:generate && git diff --exit-code -- src/gen"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.4.2",
    "prettier": "3.9.8",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@polymarket/client": "^0.11.0"
  }
}
